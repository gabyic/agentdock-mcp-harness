[Unit]
Description=AgentDock single Run Supervisor
Documentation=https://github.com/gabyic/agentdock-mcp-harness

[Service]
Type=simple
Environment=AGENTDOCK_SUPERVISOR_MODE=owner
EnvironmentFile=-%h/.config/agentdock/service.env
ExecStart=%h/.local/bin/agentdock-supervisor
Restart=always
RestartSec=2
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
FinalKillSignal=SIGKILL
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=default.target
